# pnpm'in varsayılan symlink'li (.pnpm store) node_modules yapısı Vercel'in
# serverless fonksiyon paketleyicisiyle çakışıyor ("framework produces files
# in symlinked directories" build hatası) — sharp gibi native binary içeren
# paketler bu yüzden deploy edilen bundle'a hiç girmiyordu. Hoisted (düz,
# symlink'siz) node_modules yapısı bu çakışmayı ortadan kaldırır.
node-linker=hoisted
