# wasm-vips'in .wasm dosyalarını outputFileTracingIncludes ile açıkça dahil
# etmek için pnpm'in varsayılan symlink'li (.pnpm store) node_modules yapısı
# sorun çıkarıyordu ("framework produces files in symlinked directories").
# Hoisted (düz, symlink'siz) yapı bunu ortadan kaldırır — wasm-vips native
# binary içermediği için (sharp'ın aksine) bu paket için tamamen güvenli.
node-linker=hoisted
